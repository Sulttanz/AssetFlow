# Copy to a protected path OUTSIDE the repository, e.g. /srv/it-governance/deployment.env.
# Choose an official nginx image from the upstream CRS project and pin its digest.
# No image digest or secret is fabricated in this example.
CRS_IMAGE=
NODE_IMAGE=node:22-bookworm-slim
APP_IMAGE=it-governance-app:local
SERVER_NAME=governance.example.internal
APP_ENV_FILE=/srv/it-governance/secrets/app.env
UPLOADS_DIR=/srv/it-governance/uploads
WAF_LOG_DIR=/srv/it-governance/waf-logs
TLS_CERT_FILE=/srv/it-governance/tls/fullchain.crt
TLS_KEY_FILE=/srv/it-governance/tls/server.key
WAF_RULE_ENGINE=On
