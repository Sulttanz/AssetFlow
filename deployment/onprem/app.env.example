# Store the real file outside Git/images with mode 0600 or equivalent ACLs.
# Use the organization's secret manager to populate these values.
# Native PostgreSQL is selected for standard/local URLs; Neon endpoints retain
# the Neon adapter. DB_DRIVER=pg or DB_DRIVER=neon can override selection.
DATABASE_URL=
SESSION_SECRET=
# Trust only the actual reverse proxy. Use loopback for host-native Nginx.
# This Docker example trusts one hop; do not publish the application's own port.
# Prefer the known proxy subnet/address when that network assignment is stable.
TRUST_PROXY=1
COOKIE_SECURE=auto
# Optional exact additional browser origins; same-origin needs no override.
APP_ALLOWED_ORIGINS=
